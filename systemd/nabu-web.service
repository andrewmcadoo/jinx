# nabu-web — Next.js 16 frontend for nabu (scratch tier).
# Install: sudo install -m 0644 -o root -g root nabu-web.service /etc/systemd/system/
#          sudo systemctl daemon-reload
# DO NOT enable until /srv/nabu/current-web exists (see JINX.md "Don't").
#
# nabu-bb3q (2026-05-10): switched from on-box `next start` from a full
# .next/ tree under /srv/nabu/current/apps/web to a Next.js standalone
# bundle under /srv/nabu/current-web, built and shipped by
# .github/workflows/deploy-jinx-web.yml in the nabu repo. apps/web no
# longer builds on this 2 GiB VPS (load-avg 38, swap exhausted on every
# realistic deploy). The standalone monorepo layout puts the entry
# point at <bundle-root>/apps/web/server.js, so cwd is the bundle root
# and the executable resolves apps/web/server.js relative to it.

[Unit]
Description=nabu-web (Next.js 16 frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=andrew
Group=andrew
# /srv/nabu/current-web is the symlink GH Actions atomically swaps after
# each successful deploy; it points at the active /srv/nabu/web-releases/<ts>/
# directory. The standalone bundle's monorepo tree starts here, so
# `apps/web/server.js` is the entry-point path relative to cwd.
WorkingDirectory=/srv/nabu/current-web
EnvironmentFile=/srv/nabu/shared/.env.production
Environment=NODE_ENV=production
Environment=PORT=3001
Environment=HOSTNAME=127.0.0.1
ExecStart=/home/andrew/.bun/bin/bun apps/web/server.js
Restart=on-failure
RestartSec=2s

# Hardening — mirrors systemd/_example.service.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/nabu/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# AF_NETLINK is required by getifaddrs() — Next.js / Bun call it during
# startup to enumerate network interfaces. Without it, bun terminates
# with `Unhandled Rejection: getifaddrs returned EAFNOSUPPORT (97)` and
# the service stops listening on PORT — the public URL then 502s.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
# Intentionally NOT set:
#   MemoryDenyWriteExecute=true       — breaks the V8 JIT used by Next/Bun
#   SystemCallFilter=...              — too tight for Node/Bun deps

[Install]
WantedBy=multi-user.target
