# Template for a project process. Copy to <project>-<role>.service and edit.
# Install: sudo install -m 0644 -o root -g root <project>-<role>.service /etc/systemd/system/
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now <project>-<role>
#
# The unit assumes:
#   - The deploy.sh script has already created /srv/<project>/current as a
#     symlink to a release dir.
#   - Secrets live in /srv/<project>/shared/.env.production (EnvironmentFile).
#   - The process listens on 127.0.0.1:<port> per PORTS.md.

[Unit]
Description=example-web (template — DO NOT install as-is)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=andrew
Group=andrew
WorkingDirectory=/srv/example/current
EnvironmentFile=/srv/example/shared/.env.production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=2s

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/srv/example/shared
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
# Restrict the address families the process can use. AF_UNIX for socket
# activation / local IPC, AF_INET + AF_INET6 for HTTP, AF_NETLINK for
# getifaddrs() — Bun/Node/asyncio runtimes call it on startup to
# enumerate interfaces and crash on EAFNOSUPPORT if it's missing
# (nabu-ckv4). Drops AF_PACKET, AF_BLUETOOTH, etc.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# Prevent setting personality(2) — blocks emulating older kernel ABIs
# (32-bit on 64-bit, etc.) which is a common exploit primitive.
LockPersonality=true
# Disallow SCHED_FIFO / SCHED_RR. Realtime scheduling is a known DoS vector
# (a buggy or malicious process can monopolise a CPU).
RestrictRealtime=true
# Forbid creation of suid/sgid binaries from inside the unit's writable paths.
RestrictSUIDSGID=true
# Intentionally NOT set:
#   MemoryDenyWriteExecute=true       — breaks the V8 / Node JIT
#   SystemCallFilter=...              — too tight for diverse Node/Python deps
#   CapabilityBoundingSet=            — already empty by default for User=
# Revisit MemoryDenyWriteExecute on a per-project basis if the runtime
# tolerates a non-JIT path (e.g. pure Go/Rust binaries).

[Install]
WantedBy=multi-user.target
