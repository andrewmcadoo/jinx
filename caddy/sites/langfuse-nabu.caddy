langfuse.nabu.jinx.generalproducts.io {
    tls /etc/ssl/jinx/cert.pem /etc/ssl/jinx/key.pem

    # Strip any client-supplied X-Forwarded-For BEFORE reverse_proxy.
    # Mirrors nabu.caddy — box-wide convention is to never trust inbound
    # XFF. Langfuse doesn't currently rate-limit on per-IP, but defense
    # in depth: we don't want spoofed XFF to influence any future
    # request-attribution logic in Langfuse's session/audit layer.
    request_header -X-Forwarded-For

    # Single backend: langfuse-web container, bound to 127.0.0.1:3030 on
    # the host (LANGFUSE_WEB_PORT in nabu repo: infra/langfuse/.env.example).
    # Both UI and ingest API live behind this one port — the SDK in the
    # nabu API targets https://langfuse.nabu.jinx.generalproducts.io via
    # LANGFUSE_HOST.
    reverse_proxy 127.0.0.1:3030

    import common_log langfuse-nabu
}
