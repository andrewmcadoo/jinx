nabu.jinx.generalproducts.io {
    tls /etc/ssl/jinx/cert.pem /etc/ssl/jinx/key.pem

    # CRITICAL — DO NOT REMOVE.
    # Strip any client-supplied X-Forwarded-For BEFORE reverse_proxy.
    # Caddy's reverse_proxy *appends* the immediate-peer IP to whatever
    # XFF the client sent (it does NOT strip a client-supplied XFF), so
    # without this directive a forged "X-Forwarded-For: 1.2.3.4" arrives
    # at nabu-api as "1.2.3.4, <real>".
    #
    # apps/api/app/lib/rate_limit.py:23-28 reads `xff.split(",")[0]`
    # (the LEFTMOST entry) when NABU_TRUST_PROXY=true, so any client
    # could spoof their per-IP rate-limit bucket. Stripping inbound XFF
    # makes the leftmost entry always be Caddy's appended real-peer IP.
    # See nabu repo: bd show nabu-chl7, bd show nabu-77bk.
    request_header -X-Forwarded-For

    # Path routing — must mirror apps/web/next.config.ts:34-39 exactly.
    # FastAPI mounts auth at /auth/* (no /api prefix) and the versioned
    # API at /api/v1/* (with prefix). Caddy strips /api for auth and
    # preserves it for everything else.
    #
    # NOTE: do NOT use `handle_path /api/auth/*` here. handle_path strips
    # the *full matched prefix* (`/api/auth/`), so `/api/auth/google/authorize`
    # would arrive at FastAPI as `/google/authorize` (404) instead of
    # `/auth/google/authorize` (200). Use `handle` + explicit
    # `uri strip_prefix /api` to strip only `/api`. (nabu repo: bd remember
    # caddy-handle-path-strip)

    # OAuth callback exception — must come BEFORE the broad /api/auth/*
    # rule (Caddy uses first-match). FastAPI-Users' callback returns
    # `204 No Content + Set-Cookie` for the session, which (a) leaves the
    # user on a blank page at /api/auth/google/callback?code=..., and
    # (b) Cloudflare's WAF flags the 204+Set-Cookie+google-referer shape
    # as anomalous and returns 503 to the browser even though Caddy and
    # FastAPI both see a clean 204. The Next.js Route Handler at
    # apps/web/src/app/api/auth/google/callback/route.ts exists
    # specifically to forward to FastAPI, propagate the Set-Cookie, and
    # 302 the user to /. Route the callback to Next so that handler
    # runs. (nabu repo: bd remember caddy-oauth-callback-via-next)
    handle /api/auth/google/callback {
        # The Next.js Route Handler at apps/web/src/app/api/auth/google/
        # callback/route.ts now uses X-Forwarded-Host / X-Forwarded-Proto
        # to build the redirect Location (nabu-frk5), so Caddy no longer
        # needs `header_down Location` rewriting. `header_up Host {host}`
        # is still set so any future absolute-URL construction in Next
        # also picks up the public host. Caddy populates X-Forwarded-Host
        # automatically.
        reverse_proxy 127.0.0.1:3001 {
            header_up Host {host}
        }
    }
    handle /api/auth/* {
        uri strip_prefix /api
        reverse_proxy 127.0.0.1:3101
    }
    handle /api/v1/* {
        reverse_proxy 127.0.0.1:3101
    }
    # /api/health: public liveness probe added in nabu commit 7833c14
    # specifically so Caddy can forward it without a prefix special-case.
    handle /api/health {
        reverse_proxy 127.0.0.1:3101
    }

    # Everything else → Next.js. Next's own next.config.ts rewrites act
    # as defense-in-depth: any /api/* path not explicitly routed above
    # still reaches nabu-api via the Next rewrite layer.
    handle {
        reverse_proxy 127.0.0.1:3001
    }

    import common_log nabu
}
