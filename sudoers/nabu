# Per-project NOPASSWD entries for the nabu deploy pipeline.
# Install: sudo install -m 0440 -o root -g root nabu /etc/sudoers.d/nabu
# (validate with `sudo visudo -cf /etc/sudoers.d/nabu` before installing).
#
# scripts/deploy/deploy-jinx.sh in the nabu repo runs
# `sudo -n systemctl restart nabu-{web,api}` after the atomic symlink flip.
#
# nabu-bb3q (2026-05-10): added daemon-reload + scoped `install` for
# staged unit files at /tmp/nabu-{web,api}.service.new -> /etc/systemd/system/.
# Lets the unit-cutover step in the GH Actions deploy pipeline run
# unattended. Source paths are fixed to /tmp; dest paths, mode, and
# owner are exact-matched so the entries can't be used to overwrite
# arbitrary files.

Cmnd_Alias NABU_DEPLOY = /bin/systemctl restart nabu-web, \
                         /bin/systemctl restart nabu-api, \
                         /bin/systemctl daemon-reload, \
                         /usr/bin/install -m 0644 -o root -g root /tmp/nabu-web.service.new /etc/systemd/system/nabu-web.service, \
                         /usr/bin/install -m 0644 -o root -g root /tmp/nabu-api.service.new /etc/systemd/system/nabu-api.service

andrew ALL=(root) NOPASSWD: NABU_DEPLOY
